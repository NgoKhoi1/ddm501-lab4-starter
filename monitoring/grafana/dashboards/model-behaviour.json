        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ddm501"
      },
      "targets": [
        {
          "expr": "sum by (error_type) (rate(ml_prediction_errors_total[5m]))",
          "legendFormat": "{{error_type}}",
          "refId": "A",
