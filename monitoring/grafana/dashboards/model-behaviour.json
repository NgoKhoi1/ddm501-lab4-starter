        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 14
    },
    {
      "type": "timeseries",
      "title": "Fairness gap",
      "description": "Max minus min selection rate. This is what the alert watches (0.10).",
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ddm501"
      },
      "targets": [
        {
          "expr": "ml_fairness_gap",
          "legendFormat": "gap",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ddm501"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
